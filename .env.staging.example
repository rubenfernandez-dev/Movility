# Copy to .env.staging and set values locally. Keep secrets out of Git.
MOVILITY_STAGING_PORT=3040
# Optional independent SQLite path. Media stay beside it in <database>.media/.
MOVILITY_STAGING_DB=
# SQLite and uploaded media use data/staging/ under this checkout.
# Empty for offline use. For HTTPS, set an origin without a path.
MOVILITY_STAGING_ORIGIN=
MOVILITY_STAGING_ADMIN_PASSWORD=

# simulated or stripe-test only
MOVILITY_STAGING_PAYMENT_MODE=simulated
MOVILITY_STAGING_STRIPE_SECRET_KEY=
MOVILITY_STAGING_STRIPE_WEBHOOK_SECRET=
MOVILITY_STAGING_STRIPE_METHODS=card

# simulated or resend-test only. Queue is processed manually in /admin.
MOVILITY_STAGING_EMAIL_MODE=simulated
MOVILITY_STAGING_RESEND_API_KEY=
MOVILITY_STAGING_EMAIL_FROM=
MOVILITY_STAGING_EMAIL_TEST_TO=

# off, simulated or web-push. Simulated works with these values blank.
# External delivery needs HTTPS, a stable VAPID pair and a contact (mailto:).
MOVILITY_STAGING_PUSH_MODE=off
MOVILITY_STAGING_PUSH_PUBLIC_KEY=
MOVILITY_STAGING_PUSH_PRIVATE_KEY=
MOVILITY_STAGING_PUSH_SUBJECT=
